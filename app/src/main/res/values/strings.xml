    <!-- Disclaimer -->
    <string name="disclaimer_title">Disclaimer &amp; Warning</string>
    <string name="disclaimer_message">Warning: This app is strictly for those struggling with digital habits. Once you install and enable protection, you may not be able to uninstall it. You cannot just click uninstall, and if you grant Device Administrator privileges, even standard ADB methods may fail. There is a way to uninstall it, but it is intentionally hidden. Install and use this app at your own risk.\n\nThis app does not collect or transmit any of your personal data.\n\nBy continuing, you agree not to hold the developer accountable for any issues or inability to uninstall the app.</string>
